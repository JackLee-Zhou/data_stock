# CTP 行情引擎配置
# 部署前复制为 .env：cp .env.example .env

# CTP 行情前置（必填）
CTP_MD_FRONT=tcp://182.254.243.31:30012

# CTP 交易前置（每日查询全市场合约列表用）
CTP_TRADE_FRONT=tcp://182.254.243.31:30002

# 认证信息
CTP_BROKER_ID=9999
CTP_USER_ID=你的账号
CTP_PASSWORD=你的密码

# Console TCP 端口
CTP_CONSOLE_PORT=9999
# 绑定地址（默认 127.0.0.1 仅本地访问；Docker 内应设为 0.0.0.0 通过 docker port mapping 访问）
CTP_CONSOLE_BIND=0.0.0.0

# 可选：推送到本地 Web 服务器
CTP_PUSH_URL=
CTP_PUSH_INTERVAL=10
